# Copy this to `.env` on the EC2 host, next to docker-compose.yml, and fill
# it in. docker-compose reads it automatically for ${VAR} interpolation in
# docker-compose.yml, and the `app` service also loads it wholesale via
# `env_file` for everything packages/server/index.ts reads from
# process.env. Never commit the real file (already gitignored).

# ---------------------------------------------------------------------------
# Compose-level (postgres container + Caddy)

POSTGRES_USER=deskwise
POSTGRES_PASSWORD=
POSTGRES_DB=deskwise

# The domain this deployment serves (A record must already point at this
# EC2's IP before `docker compose up`, or Caddy's automatic HTTPS/ACME
# challenge fails). e.g. app.shahzadtariq.com
APP_DOMAIN=

# Where CD's `docker compose pull` fetches the app/web images from, and
# which tag — set by GitHub Actions' deploy step (see
# .github/workflows/README.md), not something you edit by hand day to day.
# ECR_REGISTRY looks like <account-id>.dkr.ecr.<region>.amazonaws.com;
# IMAGE_TAG defaults to `latest` if unset, but CD pins it to the commit SHA
# it just built so a `docker compose up -d` here always matches what CI
# actually tested, not whatever `latest` happens to point at. The instance's
# IAM role needs ECR pull permissions for this to work (see the same doc).
ECR_REGISTRY=
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# App (packages/server) — see packages/server/.env.example for what each of
# these does. Values differ from local dev as noted.

# Host is the `postgres` service name (Docker's internal DNS), not
# localhost — they're on the same compose network.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

BETTER_AUTH_SECRET=
# Must be the real public URL, e.g. https://app.shahzadtariq.com
BETTER_AUTH_URL=
# Same origin as above — the client is served from this same domain by
# Caddy, so this is the only entry needed.
TRUSTED_ORIGINS=

ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_ASSISTANT_EMAIL=

WEBHOOK_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=

AWS_REGION=
# Deliberately omitted here, unlike local dev: on EC2, attach an IAM role
# with SES + S3 permissions to the instance instead, and the AWS SDK picks
# up credentials from the instance metadata service automatically. Setting
# these would just be a long-lived key sitting on a public-facing box.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=
KNOWLEDGE_BASE_S3_BUCKET=

# ---------------------------------------------------------------------------
# Client (packages/client) build args — baked in at image-build time, not
# read at container start. Pass as --build-arg or via docker-compose.yml's
# `build.args` (already wired to these same names).

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
