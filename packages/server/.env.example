# PostgreSQL connection string used by Prisma
DATABASE_URL=

# Sentry DSN used by lib/sentry.ts for server-side error logging. Get one
# at https://sentry.io (create a Node/Express project). Left unset,
# Sentry.init() simply no-ops and nothing is reported.
SENTRY_DSN=

# Environment tag attached to server-side Sentry events (e.g. development,
# staging, production), so errors can be filtered by where they came from.
# Falls back to NODE_ENV if unset.
SENTRY_ENVIRONMENT=

# Secret used by Better Auth to sign/encrypt sessions and tokens
BETTER_AUTH_SECRET=

# Base URL of this server, used by Better Auth for callbacks/links
BETTER_AUTH_URL=

# Email for the initial admin/seed user
ADMIN_EMAIL=

# Password for the initial admin/seed user
ADMIN_PASSWORD=

# Email identifying the seeded AI Assistant account that auto-resolved
# ticket replies are authored by (lib/tickets/ai-assistant-user.ts). It
# never has a password/Account row and can never sign in. Defaults to
# ai-assistant@deskwise.internal if unset.
AI_ASSISTANT_EMAIL=

# Comma-separated list of origins allowed to call the API (CORS)
TRUSTED_ORIGINS=

# Shared secret the inbound-email webhook caller must send in the
# x-webhook-secret header
WEBHOOK_SECRET=

# Used by the reply-polish and ticket-summarize endpoints (see
# lib/polish-reply.ts, lib/summarize-ticket.ts) to call OpenAI via
# LangChain. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model used by lib/openai-model.ts for both features above.
# Defaults to gpt-5-nano if unset.
OPENAI_MODEL=

# OpenAI embedding model used by lib/embeddings-model.ts for the knowledge
# base's document ingestion (jobs/ingest-document-job.ts). Defaults to
# text-embedding-3-small (1536 dimensions) if unset — if you change this,
# the Pinecone index below must be created with a matching dimension.
OPENAI_EMBEDDING_MODEL=

# Pinecone API key, used by the knowledge base's ingestion job and
# lib/pinecone.ts to upsert/query/delete document embeddings. Get one at
# https://app.pinecone.io
PINECONE_API_KEY=

# Name of an EXISTING Pinecone index with dimension 1536 (matching
# text-embedding-3-small) to store knowledge base embeddings in. This repo
# never creates the index for you — create it yourself in the Pinecone
# console first (serverless is fine) and put its name here.
PINECONE_INDEX_NAME=

# SendGrid API key used by lib/email/send-email.ts to send outbound reply
# emails (routes/tickets.ts's reply-create route and the auto-resolve job).
# Get one at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# A verified SendGrid sender (Single Sender or domain auth) that outbound
# reply emails are sent from.
SENDGRID_FROM_EMAIL=

# Display name used alongside SENDGRID_FROM_EMAIL. Defaults to "Customer
# Support" if unset.
SENDGRID_FROM_NAME=