# Sentry DSN used by src/main.tsx for client-side error logging. Get one
# at https://sentry.io (create a React project). Left unset, Sentry.init()
# simply no-ops and nothing is reported. Must be VITE_-prefixed to be
# exposed to client code by Vite.
VITE_SENTRY_DSN=

# Environment tag attached to client-side Sentry events (e.g. development,
# staging, production), so errors can be filtered by where they came from.
# Falls back to Vite's MODE if unset.
VITE_SENTRY_ENVIRONMENT=
